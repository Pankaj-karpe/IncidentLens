# database / broker (docker compose overrides these automatically)
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5433/IncidentLens
ALEMBIC_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5433/IncidentLens
BROKER_URL=amqp://guest:guest@localhost:5672//

# auth: generate each with  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
WEBHOOK_TOKEN=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM (Gemini free tier) + local fallback (Ollama)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
LLM_FALLBACK_MODEL=llama3.2:3b
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# notifications
SLACK_WEBHOOK_URL=
PUBLIC_BASE_URL=http://localhost:8001